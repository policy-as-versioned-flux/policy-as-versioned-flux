research/repos/

# mo-12: the six real policy-as-versioned-* repos, fetched fresh by
# clone-estate.sh so talk/up.sh and talk/verify-all.sh can run against real
# content. A build artifact of those repos, never a second copy checked in
# here — estate/ itself is gone from this hub (git history preserves it).
.estate-clone/

# The pre-mo-12 working tree, left behind when estate/ was deleted from the hub.
# `.estate-clone/` supersedes it and is the only copy anything should read. This
# entry exists so the stale one cannot be committed back by accident, which the
# rule above forbids. Whatever is left in it is local scratch: `.work/` seed
# repos and `eud/state/*.qcow2` VM disks, both build artifacts.
estate/

# Added by ggshield
.cache_ggshield

# Agent-runtime config. `.claude/settings.json` IS committed — build ticket 66's second
# propose-only layer is registered there, and the invariant suite reads the registration back out,
# so a deleted hook is a red test rather than an open door. The local override and its lockfile
# are per-machine and are not.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# twin: dev environment, python bytecode and pytest scratch
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Refusal-fixture plants. driftwood/verify-twin-overlay.sh copies a twin tree
# under the hub root (the emitter finds its package by walking up), and removes
# it in a `finally`. An interrupted run — Ctrl-C, gate timeout — leaves one
# behind; this keeps `git add -A` from sweeping it into a commit.
.plant-*/
