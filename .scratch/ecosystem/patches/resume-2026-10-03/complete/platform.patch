+    for p in open_paths:
+        if not 0.0 <= float(reach[p]) <= 1.0:
+            raise ValueError(f"reach for {p!r} is {reach[p]!r}, not a fraction of the loss")
+    return 1.0 - max((float(reach[p]) for p in open_paths), default=0.0)
