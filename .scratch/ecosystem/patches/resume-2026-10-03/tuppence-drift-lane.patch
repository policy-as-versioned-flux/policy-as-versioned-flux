+        if verdict in ("true", "false", "unknown"):
+            looked.append(f"{src['source']}: {verdict}: {ann.get(ANN + 'gitsign-verify-reason', '')}")
+        else:
+            waiting.append(src["source"])
+    return waiting, looked
+
