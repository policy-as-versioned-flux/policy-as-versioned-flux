+    for s in samples:
+        by_ts.setdefault(s["ts"], s)
+    since = [ts for ts in sorted(by_ts) if _parse_ts(ts) >= registered]
+    newest = since[-CAGE_UNMEASURED_SAMPLES:]
+    if len(newest) < CAGE_UNMEASURED_SAMPLES:
+        return []
+    out: list[str] = []
+    for name in CAGE_FACT_IDS:
+        reasons: list[str] = []
+        for ts in newest:
