+def wait_source_verdicts(context: str, timeout: float) -> int:
+    cluster = Cluster(context)
+    deadline = time.monotonic() + max(0, timeout)
+    while True:
+        waiting, looked = source_verdicts(cluster)
+        if not waiting or time.monotonic() >= deadline:
+            for line in looked:
+                print("source-verdict: " + line)
+            if waiting:
+                print(f"source-verdict: COULD NOT LOOK after {timeout:g}s: " + ", ".join(waiting))
+                return 3
+            return 0
+        time.sleep(min(2, max(0, deadline - time.monotonic())))
