[
  {
    "id": 23993294,
    "name": "main-keeps-its-history",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "~DEFAULT_BRANCH"
        ]
      }
    },
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      }
    ],
    "bypass_actors": []
  },
  {
    "id": 23993296,
    "name": "release-branches-are-reviewed",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "refs/heads/release/**"
        ]
      }
    },
    "rules": [
      {
        "type": "creation"
      },
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "pull_request",
        "parameters": {
          "required_approving_review_count": 1,
          "dismiss_stale_reviews_on_push": false,
          "required_reviewers": [],
          "require_code_owner_review": false,
          "dismissal_restriction": {
            "enabled": false,
            "allowed_actors": []
          },
          "require_last_push_approval": false,
          "required_review_thread_resolution": false,
          "require_extra_approval_for_unattributed_changes": true,
          "allowed_merge_methods": [
            "merge",
            "squash",
            "rebase"
          ]
        }
      }
    ],
    "bypass_actors": []
  },
  {
    "id": 23993299,
    "name": "release-tags-hold",
    "target": "tag",
    "enforcement": "active",
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "~ALL"
        ]
      }
    },
    "rules": [
      {
        "type": "update"
      },
      {
        "type": "deletion"
      }
    ],
    "bypass_actors": []
  }
]
