+    result: pass
+  - policy: posture-trust-boundary-6-0-0
+    kind: Pod
+    resources: [pod-forged-mismatch]
+    result: fail
+  - policy: posture-trust-boundary-6-0-0
+    kind: Pod
+    resources: [pod-no-posture, pod-other-version, pod-forged-no-claim]
