+---
+apiVersion: v1
+kind: Pod
+metadata: { name: pod-violating, labels: { "policy-as-versioned.dev/policy-version": "6.0.0" } }
+spec:
+  securityContext: { runAsNonRoot: true }
+  containers: [{ name: c, image: nginx }]
+---
+apiVersion: v1
+kind: Pod
+metadata:
+  name: pod-root-attested
+  labels:
+    policy-as-versioned.dev/policy-version: "6.0.0"
