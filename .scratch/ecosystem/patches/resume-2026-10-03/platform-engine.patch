diff --git a/computed-semver/test_cage_netpol_fixture.py b/computed-semver/test_cage_netpol_fixture.py
new file mode 100644
index 0000000..4b2b9fe
--- /dev/null
+++ b/computed-semver/test_cage_netpol_fixture.py
@@ -0,0 +1,42 @@
+"""Actual generated-document seam: removing either gate must change the grade."""
+from pathlib import Path
+import importlib.util
+import os
+import shutil
+import tempfile
+import unittest
+import yaml
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location("cells", HERE / "engine_compatibility.py")
+cells = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(cells)
+
+class GeneratedDocuments(unittest.TestCase):
+    def test_each_generation_gate_is_observed_on_each_available_engine(self):
+        folder = HERE.parent / "graded/tests/cage-netpol"
+        engine_dir = os.environ.get("KYVERNO_ENGINE_DIR")
+        binaries = sorted(Path(engine_dir).glob("*/kyverno")) if engine_dir else []
+        if not binaries and shutil.which("kyverno"):
+            binaries = [Path(shutil.which("kyverno"))]
+        if not binaries:
+            self.skipTest("no Kyverno binary available for generated-document proof")
+        for binary in binaries:
+            for gate in [None, "tier-restricts-reach", "is-caged"]:
+                with self.subTest(engine=binary.parent.name, gate=gate), tempfile.TemporaryDirectory() as temp:
+                    work = Path(temp)
+                    fixture = work / "fixture"
+                    shutil.copytree(folder, fixture)
+                    policy = yaml.safe_load((HERE.parent / "graded/policies/cage-netpol.yaml").read_text())
+                    policy["metadata"]["name"] += "-9-9-9"
+                    policy["spec"].setdefault("matchConditions", []).append({"name":"only-this-policy-version", "expression":"object.metadata.?labels['policy-as-versioned.dev/policy-version'].orValue('') == '9.9.9'"})
+                    if gate:
+                        policy["spec"]["matchConditions"] = [c for c in policy["spec"]["matchConditions"] if c["name"] != gate]
+                    path=work / "policy.yaml"
+                    path.write_text(yaml.safe_dump(policy, sort_keys=False))
+                    body={"family":"cage-netpol", "names":[policy["metadata"]["name"]], "path":path}
+                    report=cells.run_legacy_fixture(fixture, body, "9.9.9", str(binary))
+                    self.assertEqual(report["outcome"], "failed" if gate else "passed", report)
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/distribution/policies/v6.0.0/cage-netpol.yaml b/distribution/policies/v6.0.0/cage-netpol.yaml
new file mode 100644
index 0000000..60e1854
--- /dev/null
+++ b/distribution/policies/v6.0.0/cage-netpol.yaml
@@ -0,0 +1,45 @@
+# Self-scopes via matchConditions on the policy-version label -- NOT
+# matchConstraints.objectSelector, which Kyverno flattens into one shared
+# ValidatingWebhookConfiguration (last-reconciled-wins) and silently breaks
+# multi-version coexistence.
+apiVersion: policies.kyverno.io/v1alpha1
+kind: GeneratingPolicy
+metadata:
+  name: cage-netpol-6-0-0
+  labels:
+    app.kubernetes.io/part-of: platform
+    policy-as-versioned.dev/policy: graded-enforcement
+    policy-as-versioned.dev/policy-version: 6.0.0
+spec:
+  evaluation:
+    synchronize:
+      enabled: false
+  matchConstraints:
+    resourceRules:
+    - apiGroups:
+      - ''
+      apiVersions:
+      - v1
+      operations:
+      - CREATE
+      - UPDATE
+      resources:
+      - pods
+  matchConditions:
+  - name: is-caged
+    expression: object.metadata.?labels['posture.acme.io/caged'].orValue('') == 'true'
+  - name: tier-restricts-reach
+    expression: object.metadata.?labels['posture.acme.io/tier'].orValue('baseline') != 'baseline'
+  - name: only-this-policy-version
+    expression: object.metadata.?labels['policy-as-versioned.dev/policy-version'].orValue('') == '6.0.0'
+  variables:
+  - name: nsName
+    expression: string(object.metadata.namespace)
+  - name: tier
+    expression: object.metadata.?labels['posture.acme.io/tier'].orValue('baseline')
+  - name: rungs
+    expression: '[''restricted'', ''quarantine'', ''isolated'']'
+  - name: reach
+    expression: "{'isolated': {'ingress': dyn([]), 'egress': dyn([])},\n 'other':    {'ingress': dyn([dyn({\"from\": dyn([dyn({\"podSelector\": dyn({})})])})]),\n              'egress':  dyn([dyn({\n                \"to\": dyn([dyn({\"namespaceSelector\": dyn({\"matchLabels\": dyn({\"kubernetes.io/metadata.name\": dyn(\"kube-system\")})})})]),\n                \"ports\": dyn([dyn({\"protocol\": dyn(\"UDP\"), \"port\": dyn(53)})])})])}}"
+  generate:
+  - expression: "generator.Apply(variables.nsName, variables.rungs.map(t, dyn({\n  \"apiVersion\": dyn(\"networking.k8s.io/v1\"),\n  \"kind\": dyn(\"NetworkPolicy\"),\n  \"metadata\": dyn({\"name\": dyn(\"cage-reach-\" + t), \"namespace\": dyn(variables.nsName),\n               \"labels\": dyn({\"app.kubernetes.io/managed-by\": dyn(\"kyverno\"),\n                              \"posture.acme.io/cage\": dyn(\"reach\"),\n                              \"posture.acme.io/tier\": dyn(t)})}),\n  \"spec\": dyn({\n    \"podSelector\": dyn({\"matchLabels\": dyn({\"posture.acme.io/caged\": dyn(\"true\"),\n                                            \"posture.acme.io/tier\": dyn(t)})}),\n    \"policyTypes\": dyn([\"Ingress\", \"Egress\"]),\n    \"ingress\": dyn(variables.reach[t == 'isolated' ? 'isolated' : 'other'].ingress),\n    \"egress\": dyn(variables.reach[t == 'isolated' ? 'isolated' : 'other'].egress)})})\n))"
diff --git a/distribution/policies/v6.0.0/cage-tier.yaml b/distribution/policies/v6.0.0/cage-tier.yaml
new file mode 100644
index 0000000..fd76c69
--- /dev/null
+++ b/distribution/policies/v6.0.0/cage-tier.yaml
@@ -0,0 +1,43 @@
+# Self-scopes via matchConditions on the policy-version label -- NOT
+# matchConstraints.objectSelector, which Kyverno flattens into one shared
+# ValidatingWebhookConfiguration (last-reconciled-wins) and silently breaks
+# multi-version coexistence.
+apiVersion: policies.kyverno.io/v1alpha1
+kind: MutatingPolicy
+metadata:
+  name: cage-tier-6-0-0
+  labels:
+    app.kubernetes.io/part-of: platform
+    policy-as-versioned.dev/policy: graded-enforcement
+    policy-as-versioned.dev/policy-version: 6.0.0
+spec:
+  matchConstraints:
+    resourceRules:
+    - apiGroups:
+      - ''
+      apiVersions:
+      - v1
+      operations:
+      - CREATE
+      - UPDATE
+      resources:
+      - pods
+  matchConditions:
+  - name: claims-a-policy-version
+    expression: object.metadata.?labels['policy-as-versioned.dev/policy-version'].orValue('') != ''
+  - name: only-this-policy-version
+    expression: object.metadata.?labels['policy-as-versioned.dev/policy-version'].orValue('') == '6.0.0'
+  variables:
+  - name: nsTier
+    expression: "namespaceObject != null && namespaceObject.metadata.?labels['policy-as-versioned.dev/governed'].orValue('') == 'true'\n  ? namespaceObject.metadata.?labels['posture.acme.io/tier'].orValue('')\n  : ''"
+  - name: tier
+    expression: "variables.nsTier in ['baseline', 'restricted', 'quarantine', 'isolated']\n  ? variables.nsTier\n  : 'isolated'"
+  - name: dial
+    expression: "{'baseline':  {'cpu':'500m','mem':'256Mi','pc':'cage-baseline-6-0-0',  'prio':'-10',   'harden':'false','wafCpu':'0',   'wafMem':'0'},\n 'restricted':{'cpu':'250m','mem':'128Mi','pc':'cage-restricted-6-0-0','prio':'-100',  'harden':'true', 'wafCpu':'100m','wafMem':'128Mi'},\n 'quarantine':{'cpu':'100m','mem':'64Mi', 'pc':'cage-quarantine-6-0-0','prio':'-1000', 'harden':'true', 'wafCpu':'250m','wafMem':'256Mi'},\n 'isolated':  {'cpu':'100m','mem':'64Mi', 'pc':'cage-isolated-6-0-0',  'prio':'-10000','harden':'true', 'wafCpu':'250m','wafMem':'256Mi'}}[variables.tier]"
+  mutations:
+  - patchType: ApplyConfiguration
+    applyConfiguration:
+      expression: "Object{\n  metadata: Object.metadata{ labels: {\n    \"posture.acme.io/caged\": \"true\",\n    \"posture.acme.io/tier\": variables.tier\n  } },\n  spec: Object.spec{\n    hostNetwork: false,\n    hostPID: false,\n    hostIPC: false,\n    priorityClassName: variables.dial.pc,\n    priority: int(variables.dial.prio),\n    preemptionPolicy: \"Never\",\n    containers: object.spec.containers.filter(c, c.name != \"waf-sidecar\").map(c, Object.spec.containers{\n      name: c.name,\n      resources: Object.spec.containers.resources{\n        limits: {\n          \"cpu\": (has(c.resources) && c.resources.?limits[\"cpu\"].hasValue() &&\n                  quantity(string(c.resources.limits[\"cpu\"])).isLessThan(quantity(variables.dial.cpu)))\n                   ? string(c.resources.limits[\"cpu\"]) : variables.dial.cpu,\n          \"memory\": (has(c.resources) && c.resources.?limits[\"memory\"].hasValue() &&\n                  quantity(string(c.resources.limits[\"memory\"])).isLessThan(quantity(variables.dial.mem)))\n                   ? string(c.resources.limits[\"memory\"]) : variables.dial.mem\n        }\n      },\n      securityContext: Object.spec.containers.securityContext{\n        readOnlyRootFilesystem: variables.dial.harden == 'true' ||\n          (has(c.securityContext) && c.securityContext.?readOnlyRootFilesystem.orValue(false)),\n        runAsNonRoot: variables.dial.harden == 'true' ||\n          c.?securityContext.?runAsNonRoot.orValue(object.spec.?securityContext.?runAsNonRoot.orValue(false)),\n        allowPrivilegeEscalation: false,\n        privileged: false\n      }\n    }) + (variables.dial.wafCpu != '0' ? [Object.spec.containers{\n      name: \"waf-sidecar\",\n      image: \"ghcr.io/acme/coraza-waf:cage\",\n      resources: Object.spec.containers.resources{\n        limits: {\"cpu\": variables.dial.wafCpu, \"memory\": variables.dial.wafMem}\n      },\n      securityContext: Object.spec.containers.securityContext{\n        readOnlyRootFilesystem: true, runAsNonRoot: true,\n        allowPrivilegeEscalation: false, privileged: false\n      }\n    }] : [])\n  }\n}"
+  - patchType: JSONPatch
+    jsonPatch:
+      expression: "variables.dial.harden == 'true'\n  ? object.spec.containers.map(c,\n      JSONPatch{\n        op: \"add\",\n        path: \"/spec/containers/\" + string(object.spec.containers.indexOf(c)) + \"/securityContext/capabilities\",\n        value: {\"drop\": [\"ALL\"]}\n      })\n  : []"
