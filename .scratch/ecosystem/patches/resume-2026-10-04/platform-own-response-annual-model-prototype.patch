+++ b/compose/test_own_response_model_cli.py
@@ -0,0 +1,172 @@
+"""Public prototype adapter checks; authored fixtures never become adopter evidence."""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+import jsonschema
+
+from test_own_response_model import declared_fixture
+
+HERE = Path(__file__).resolve().parent
+CLI = HERE / "own_response_model_cli.py"
+SCHEMA = HERE.parent / "feeds/forward-intel.v3.payload.schema.json"
+FIXTURES = HERE / "fixtures/own-response-model"
+
+
+def curve_hash(curve: list) -> str:
+    return "sha256:" + hashlib.sha256(json.dumps(
+        curve, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest()
+
+
+def fixture():
+    payload = declared_fixture()
+    payload.update(shock="Authored prototype fixture; not a world observation", horizon=1,
+                   lef=[4, 4, 4], register=[], claim_scope={"included": [], "excluded": []},
+                   derived_from=[{"party": "declared-fixture", "kind": "feed",
+                                  "name": "authored-frequency", "version": "1.0.0"}])
+    feed = {"kind": "feed", "name": "forward-intel", "version": "3.0.0",
+            "published_by": "declared-fixture", "published_at": "2026-10-04T00:00:00Z",
+            "payload_schema": "declared-prototype", "payload": payload}
+    row = {"source": "twin", "kind": "twin", "name": "forward-intel",
+           "feed_version": feed["version"], "amount": 4000000,
+           "currency": "GBP", "perspective": "declared-fixture", "rests_on_grade": 3,
+           "horizon": 1, "lef": [4, 4, 4], "curve_hash": curve_hash(payload["curve"])}
+    return feed, {"outcome": "composed", "prices": [row]}
+
+
+class OwnResponseCLI(unittest.TestCase):
+    def invoke(self, feed, evidence, *, threshold=3, raw_feed=None):
+        with tempfile.TemporaryDirectory(prefix="own-response-cli-fixture-") as temporary:
+            directory = Path(temporary)
+            feed_path, evidence_path = directory / "feed.json", directory / "evidence.json"
+            feed_path.write_text(raw_feed if raw_feed is not None else json.dumps(feed))
+            evidence_path.write_text(json.dumps(evidence))
+            before = (feed_path.read_bytes(), evidence_path.read_bytes())
+            result = subprocess.run([sys.executable, str(CLI), "--feed", str(feed_path),
+                                     "--evidence", str(evidence_path), "--threshold", str(threshold)],
+                                    capture_output=True, text=True, check=False)
+            self.assertEqual(before, (feed_path.read_bytes(), evidence_path.read_bytes()))
+            self.assertEqual(result.stderr, "", result.stderr)
+            return result.returncode, json.loads(result.stdout), before
+
+    def refused(self, feed, evidence, **kwargs):
+        code, result, _ = self.invoke(feed, evidence, **kwargs)
+        self.assertEqual(code, 3, result)
+        self.assertEqual(result["outcome"], "missing-instrument")
+        self.assertNotIn("model", result)
+        return result["reason"]
+
+    def test_declared_annual_cost_booked_once_with_readonly_provenance(self):
+        feed, evidence = fixture()
+        code, result, inputs = self.invoke(feed, evidence)
+        self.assertEqual(code, 0)
+        self.assertEqual(result["model"]["residuals"]["baseline"], 4000000)
+        self.assertEqual(result["model"]["annual_total_costs"]["baseline"], 4000500)
+        self.assertEqual(result["model"]["rests_on_grade"], 3)
+        self.assertEqual(len(result["model"]["excluded_mitigations"]), 4)
+        provenance = result["input_provenance"]
+        self.assertEqual(provenance["feed_sha256"], hashlib.sha256(inputs[0]).hexdigest())
+        self.assertEqual(provenance["evidence_sha256"], hashlib.sha256(inputs[1]).hexdigest())
+        self.assertEqual(provenance["annual_loss"]["period"], "year")
+        self.assertEqual(provenance["source_authentication"], "not checked by this prototype")
+
+    def test_genuine_legacy_feeds_have_no_model_and_remain_missing_instrument(self):
+        for org in ("ludlow", "tuppence"):
+            with self.subTest(org=org):
+                feed = json.loads((FIXTURES / (org + "-v1-feed.json")).read_text())
+                row = fixture()[1]["prices"][0]
+                row.update(feed_version=feed["version"], perspective=feed["payload"]["perspective"],
+                           currency=feed["payload"]["currency"], horizon=feed["payload"]["horizon"],
+                           curve_hash=curve_hash(feed["payload"]["curve"]))
+                reason = self.refused(feed, {"outcome": "composed", "prices": [row]})
+                self.assertIn("response_model", reason)
+
+    def test_unique_price_version_curve_and_frequency_join(self):
+        for mutation in ("missing", "duplicate", "version", "curve", "horizon", "frequency"):
+            with self.subTest(mutation=mutation):
+                feed, evidence = fixture()
+                row = evidence["prices"][0]
+                if mutation == "missing": evidence["prices"] = []
+                elif mutation == "duplicate": evidence["prices"].append(copy.deepcopy(row))
+                elif mutation == "version": row["feed_version"] = "2.0.0"
+                elif mutation == "curve": row["curve_hash"] = "sha256:" + "0" * 64
+                elif mutation == "horizon": row["horizon"] = 2
+                else: row["lef"] = [3, 3, 3]
+                self.refused(feed, evidence)
+
+    def test_multiyear_and_unrepresentable_horizons_refuse_without_traceback(self):
+        for horizon in (2, True, 10 ** 400):
+            with self.subTest(horizon_type=type(horizon).__name__):
+                feed, evidence = fixture()
+                feed["payload"]["horizon"] = evidence["prices"][0]["horizon"] = horizon
+                self.refused(feed, evidence)
+
+    def test_money_holes_remain_typed_and_no_partial_total(self):
+        for mutation in ("cost-grade", "cost-period", "cost-nature", "currency", "perspective",
+                         "amount-bool", "loss-grade", "threshold"):
+            with self.subTest(mutation=mutation):
+                feed, evidence = fixture()
+                cost = feed["payload"]["response_model"]["responses"][0]["control_cost"]
+                row = evidence["prices"][0]
+                if mutation == "cost-grade": cost.pop("evidence_grade")
+                elif mutation == "cost-period": cost["period"] = "event"
+                elif mutation == "cost-nature": cost["nature"] = "authorised-budget"
+                elif mutation == "currency": row["currency"] = "USD"
+                elif mutation == "perspective": row["perspective"] = "another-party"
+                elif mutation == "amount-bool": row["amount"] = True
+                elif mutation == "loss-grade": row["rests_on_grade"] = 5
+                self.refused(feed, evidence, threshold=2 if mutation == "threshold" else 3)
+
+    def test_nonfinite_and_duplicate_json_refuse(self):
+        feed, evidence = fixture()
+        self.assertIn("duplicate", self.refused(feed, evidence, raw_feed='{"kind":"feed","kind":"feed"}'))
+        for value in ("NaN", "Infinity", "1e999"):
+            with self.subTest(value=value):
+                raw = json.dumps(feed).replace('"residual_loss_per_event": 1000000',
+                                               '"residual_loss_per_event": ' + value, 1)
+                self.refused(feed, evidence, raw_feed=raw)
+
+
+class OwnResponseSchema(unittest.TestCase):
+    def setUp(self):
+        self.schema = json.loads(SCHEMA.read_text())
+        jsonschema.Draft7Validator.check_schema(self.schema)
+        self.validator = jsonschema.Draft7Validator(self.schema)
+
+    def test_explicit_declared_contract_validates(self):
+        self.validator.validate(fixture()[0]["payload"])
+
+    def test_closed_fields_and_money_period_grade_nature_are_required(self):
+        for mutation in ("missing-model", "model-extra", "cost-extra", "grade5", "grade-bool",
+                         "period", "nature", "measurement-grade3", "estimate-grade2", "missing-account",
+                         "duplicate-account", "source-parent", "source-absolute", "source-dot"):
+            with self.subTest(mutation=mutation):
+                payload = fixture()[0]["payload"]
+                model = payload["response_model"]
+                cost = model["responses"][0]["control_cost"]
+                if mutation == "missing-model": payload.pop("response_model")
+                elif mutation == "model-extra": model["guess"] = 0
+                elif mutation == "cost-extra": cost["budget"] = True
+                elif mutation == "grade5": cost["evidence_grade"] = 5
+                elif mutation == "grade-bool": cost["evidence_grade"] = True
+                elif mutation == "period": cost.pop("period")
+                elif mutation == "nature": cost["nature"] = "authorised-budget"
+                elif mutation == "measurement-grade3": cost["nature"] = "measurement"
+                elif mutation == "estimate-grade2": cost["evidence_grade"] = 2
+                elif mutation == "missing-account": model["responses"].pop()
+                elif mutation == "duplicate-account": model["responses"][1]["account"] = "baseline"
+                elif mutation == "source-parent": model["responses"][0]["source"]["path"] = "../cost.yaml"
+                elif mutation == "source-absolute": model["responses"][0]["source"]["path"] = "/cost.yaml"
+                else: model["responses"][0]["source"]["path"] = "cost/./source.yaml"
+                self.assertTrue(list(self.validator.iter_errors(payload)), mutation)
+
+
+if __name__ == "__main__":
+    unittest.main()
