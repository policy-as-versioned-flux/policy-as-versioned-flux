new file mode 100644
index 0000000..741dd3b
--- /dev/null
+++ b/compose/own_response_model_cli.py
@@ -0,0 +1,119 @@
+"""Read-only prototype adapter for explicitly graded own-response instruments.
+
+The supplied composition already annualised the loss. This adapter never runs an
+adopter, verifies a signature, writes a source, or selects an enforcement tier.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+from typing import Any
+
+from own_response_model import MissingInstrument, annual_responses
+
+
+def _object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise MissingInstrument(f"duplicate JSON field {key!r}")
+        result[key] = value
+    return result
+
+
+def _constant(value: str) -> None:
+    raise MissingInstrument(f"non-finite JSON number {value!r}")
+
+
+def _read(path: Path) -> tuple[dict[str, Any], str]:
+    try:
+        content = path.read_bytes()
+        value = json.loads(content, object_pairs_hook=_object, parse_constant=_constant)
+    except (OSError, UnicodeDecodeError, ValueError) as error:
+        raise MissingInstrument(f"cannot read JSON instrument {path}: {error}") from None
+    if not isinstance(value, dict):
+        raise MissingInstrument(f"JSON instrument {path} must be an object")
+    return value, hashlib.sha256(content).hexdigest()
+
+
+def _annual_loss(feed: dict[str, Any], evidence: dict[str, Any]) -> dict[str, Any]:
+    if feed.get("kind") != "feed" or feed.get("name") != "forward-intel":
+        raise MissingInstrument("feed must be a forward-intel envelope")
+    payload = feed.get("payload")
+    if not isinstance(payload, dict):
+        raise MissingInstrument("forward-intel envelope has no payload object")
+    if evidence.get("outcome") != "composed":
+        raise MissingInstrument("annual loss requires a composed evidence outcome")
+    prices = evidence.get("prices")
+    if not isinstance(prices, list):
+        raise MissingInstrument("composition has no prices array")
+    rows = [row for row in prices if isinstance(row, dict)
+            and row.get("source") == "twin" and row.get("kind") == "twin"
+            and row.get("name") == "forward-intel"]
+    if len(rows) != 1:
+        raise MissingInstrument("composition must contain exactly one forward-intel twin price")
+    row = rows[0]
+    version = feed.get("version")
+    if not isinstance(version, str) or not version or row.get("feed_version") != version:
+        raise MissingInstrument("annual loss does not name the supplied feed version")
+    curve = payload.get("curve")
+    if not isinstance(curve, list):
+        raise MissingInstrument("forward-intel payload has no curve array")
+    try:
+        encoded = json.dumps(curve, sort_keys=True, separators=(",", ":"),
+                             ensure_ascii=False, allow_nan=False).encode("utf-8")
+    except ValueError:
+        raise MissingInstrument("forward-intel curve contains a non-finite number") from None
+    curve_hash = "sha256:" + hashlib.sha256(encoded).hexdigest()
+    if row.get("curve_hash") != curve_hash:
+        raise MissingInstrument("annual loss curve hash does not match the supplied feed")
+    horizon = payload.get("horizon")
+    try:
+        valid_horizon = (not isinstance(horizon, bool) and isinstance(horizon, (int, float))
+                         and math.isfinite(horizon) and horizon > 0)
+    except OverflowError:
+        valid_horizon = False
+    if (not valid_horizon or isinstance(row.get("horizon"), bool)
+            or row.get("horizon") != horizon):
+        raise MissingInstrument("annual loss horizon does not match the supplied feed")
+    if horizon != 1:
+        raise MissingInstrument("existing composition supplies no explicit annual amount period "
+                                "for a horizon other than one year")
+    if payload.get("lef") is not None and payload["lef"] != row.get("lef"):
+        raise MissingInstrument("annual loss frequency does not match the supplied explicit feed")
+    return {"amount": row.get("amount"), "currency": row.get("currency"),
+            "period": "year", "perspective": row.get("perspective"),
+            "rests_on_grade": row.get("rests_on_grade"),
+            "frequency": {"triple": row.get("lef"), "horizon_years": horizon}}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--feed", type=Path, required=True, help="Supplied forward-intel envelope")
+    parser.add_argument("--evidence", type=Path, required=True, help="Supplied composed evidence.json")
+    parser.add_argument("--threshold", type=int, choices=(2, 3), required=True,
+                        help="The consuming party's explicit declared threshold")
+    args = parser.parse_args()
+    try:
+        feed, feed_hash = _read(args.feed)
+        evidence, evidence_hash = _read(args.evidence)
+        annual_loss = _annual_loss(feed, evidence)
+        result = annual_responses(feed["payload"], annual_loss, args.threshold)
+        output = {"outcome": "priced-prototype", "model": result,
+                  "input_provenance": {"feed_sha256": feed_hash,
+                                       "evidence_sha256": evidence_hash,
+                                       "declared_threshold": args.threshold,
+                                       "source_authentication": "not checked by this prototype",
+                                       "annual_loss": annual_loss}}
+        print(json.dumps(output, sort_keys=True, allow_nan=False))
+    except MissingInstrument as error:
+        print(json.dumps({"outcome": "missing-instrument", "reason": str(error)}, sort_keys=True))
+        return 3
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/compose/test_own_response_model.py b/compose/test_own_response_model.py
new file mode 100644
index 0000000..c15f540
--- /dev/null
+++ b/compose/test_own_response_model.py
@@ -0,0 +1,152 @@
+"""A strict new model contract; old genuine feeds do not pretend to provide it."""
+import copy
+import json
+from pathlib import Path
+import unittest
+
+import yaml
+
+import own_response_model as model
+
+LADDER = ('baseline', 'restricted', 'quarantine', 'isolated')
+FIXTURES = Path(__file__).with_name('fixtures') / 'own-response-model'
+
+
+def declared_fixture():
+    """Authored cost grades/units, never adopted as real LU/TU evidence."""
+    rows = []
+    curve = []
+    for account, reduction, cost in zip(LADDER, (0.30, 0.70, 0.92, 0.98), (500, 2000, 6000, 15000)):
+        rows.append({'account': account,
+                     'mitigation': {'triple': [reduction] * 3, 'evidence_grade': 5,
+                                    'basis': 'Declared fixture calibration claim; not observed'},
+                     'control_cost': {'triple': [cost] * 3, 'currency': 'GBP', 'period': 'year',
+                                      'evidence_grade': 3, 'nature': 'published-estimate',
+                                      'basis': 'Explicitly authored public-contract fixture; no real adopter grade'},
+                     'source': {'path': 'declared-fixture/' + account + '.yaml', 'sha256': 'a' * 64}})
+        curve.append({'account': account, 'residual_loss_per_event': 1000000,
+                      'annual_control_cost': cost})
+    return {'perspective': 'declared-fixture', 'currency': 'GBP', 'lm': [1000000] * 3, 'horizon': 1,
+            'rests_on_grade': 3, 'curve': curve,
+            'response_model': {'version': '1.0.0', 'loss_period': 'event',
+                               'cost_period': 'year', 'responses': rows}}
+
+
+class AnnualResponses(unittest.TestCase):
+    def setUp(self):
+        self.payload = declared_fixture()
+        self.loss = {'amount': 4000000, 'currency': 'GBP', 'period': 'year',
+                     'perspective': 'declared-fixture', 'rests_on_grade': 3,
+                     'frequency': {'triple': [4, 4, 4], 'horizon_years': 1}}
+
+    def run_model(self, payload=None, loss=None, threshold=3):
+        return model.annual_responses(payload or self.payload, loss or self.loss, threshold)
+
+    def test_grade_five_earns_no_credit_and_annual_cost_is_booked_once(self):
+        r = self.run_model()
+        self.assertEqual(r['residuals'], dict.fromkeys(LADDER, 4000000))
+        self.assertEqual(r['annual_control_costs']['isolated'], 15000)
+        self.assertEqual(r['annual_total_costs']['isolated'], 4015000)
+        self.assertEqual(r['rests_on_grade'], 3)
+        self.assertEqual(len(r['excluded_mitigations']), 4)
+
+    def test_admitted_mitigation_uses_its_own_triple_not_the_platform_table(self):
+        for row, curve in zip(self.payload['response_model']['responses'], self.payload['curve']):
+            row['mitigation'].update(triple=[0.05, 0.10, 0.15], evidence_grade=3)
+            curve['residual_loss_per_event'] = 900000
+        r = self.run_model()
+        self.assertEqual(r['residuals']['baseline'], 3600000)
+        self.assertEqual(r['annual_total_costs']['baseline'], 3600500)
+
+    def test_grade_four_and_five_mitigation_never_change_the_admitted_money(self):
+        for grade in (4, 5):
+            with self.subTest(grade=grade):
+                for row in self.payload['response_model']['responses']:
+                    row['mitigation']['evidence_grade'] = grade
+                self.assertEqual(self.run_model()['residuals'], dict.fromkeys(LADDER, 4000000))
+
+    def test_genuine_ludlow_tuppence_old_payloads_lack_annual_cost_instruments(self):
+        for org in ('ludlow', 'tuppence'):
+            with self.subTest(org=org):
+                feed = json.loads((FIXTURES / (org + '-v1-feed.json')).read_text())
+                self.assertNotIn('response_model', feed['payload'])
+                sources = json.loads((FIXTURES / (org + '-v4-response-sources.json')).read_text())
+                for source in sources.values():
+                    response = yaml.safe_load(source['yaml'])
+                    self.assertNotIn('evidence_grade', response['cost'])
+                    self.assertNotIn('period', response['cost'])
+                    self.assertEqual(response['mitigates']['evidence_grade'], 5)
+                with self.assertRaises(model.MissingInstrument):
+                    self.run_model(feed['payload'])
+
+    def test_missing_invalid_or_nonadmitted_cost_never_becomes_zero_or_partial_total(self):
+        for key, value in (('period', None), ('evidence_grade', None), ('evidence_grade', True),
+                           ('evidence_grade', 4), ('evidence_grade', 5), ('triple', [1, 2]),
+                           ('triple', [1, float('nan'), 3]), ('nature', None), ('basis', '')):
+            with self.subTest(key=key, value=value):
+                payload = copy.deepcopy(self.payload)
+                payload['response_model']['responses'][0]['control_cost'][key] = value
+                with self.assertRaises(model.MissingInstrument):
+                    self.run_model(payload)
+
+    def test_tampered_curve_or_missing_unknown_duplicate_accounts_refuse(self):
+        for change in ('curve', 'missing', 'unknown', 'duplicate', 'source'):
+            with self.subTest(change=change):
+                payload = copy.deepcopy(self.payload)
+                if change == 'curve':
+                    payload['curve'][0]['residual_loss_per_event'] -= 1
+                elif change == 'missing':
+                    payload['response_model']['responses'].pop()
+                elif change == 'unknown':
+                    payload['response_model']['responses'][0]['account'] = 'no-such-rung'
+                elif change == 'duplicate':
+                    payload['response_model']['responses'].append(payload['response_model']['responses'][0])
+                else:
+                    payload['response_model']['responses'][0]['source']['path'] = '../undeclared.yaml'
+                with self.assertRaises(model.MissingInstrument):
+                    self.run_model(payload)
+
+    def test_currency_perspective_frequency_and_unit_ambiguity_refuse(self):
+        for key, value in (('currency', 'USD'), ('perspective', 'somebody-else'), ('period', 'event'),
+                           ('frequency', {'triple': [4, 4, 4]}), ('rests_on_grade', 5), ('amount', True)):
+            with self.subTest(key=key):
+                loss = copy.deepcopy(self.loss)
+                loss[key] = value
+                with self.assertRaises(model.MissingInstrument):
+                    self.run_model(loss=loss)
+        for threshold in (None, 4, 5, True):
+            with self.subTest(threshold=threshold), self.assertRaises(model.MissingInstrument):
+                self.run_model(threshold=threshold)
+
+    def test_known_zero_and_absent_mitigation_are_explicit(self):
+        self.loss['amount'] = 0
+        self.payload['lm'] = [0, 0, 0]
+        for curve in self.payload['curve']:
+            curve['residual_loss_per_event'] = 0
+        for row in self.payload['response_model']['responses']:
+            row['mitigation'] = None
+        self.assertEqual(self.run_model()['residuals'], dict.fromkeys(LADDER, 0))
+        for row, curve in zip(self.payload['response_model']['responses'], self.payload['curve']):
+            row['control_cost']['triple'] = [0, 0, 0]
+            curve['annual_control_cost'] = 0
+        self.assertEqual(self.run_model()['annual_total_costs'], dict.fromkeys(LADDER, 0))
+
+    def test_nonfinite_derived_total_or_frequency_refuses(self):
+        with self.subTest(derived='annual total'):
+            self.loss['amount'] = 1e308
+            for row, curve in zip(self.payload['response_model']['responses'], self.payload['curve']):
+                row['control_cost']['triple'] = [1e308] * 3
+                curve['annual_control_cost'] = 1e308
+            with self.assertRaises(model.MissingInstrument):
+                self.run_model()
+        with self.subTest(derived='annual frequency'):
+            self.payload = declared_fixture()
+            self.loss['amount'] = 4000000
+            self.payload['horizon'] = 1e-308
+            self.loss['frequency']['horizon_years'] = 1e-308
+            with self.assertRaises(model.MissingInstrument):
+                self.run_model()
+
+
+if __name__ == '__main__':
+    unittest.main()
