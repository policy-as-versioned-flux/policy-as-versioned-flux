+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://policy-as-versioned.dev/schema/feeds/forward-intel.v3.prototype.json",
+  "title": "PROTOTYPE forward-intel payload v3: own graded response model",
+  "$comment": "PROTOTYPE VERSION 3.0.0, not released or adopted. Explicit event residual loss and separately annual control cost. No ungraded budget variant. Immutable v2 source is unchanged.",
+  "description": "Prototype scenario contract: the estate annualises lm once; the own-response mapper applies admitted mitigation and adds an explicitly graded annual control cost once. A curve decomposes per-event residual loss and annual control cost; it never recommends or selects a tier. These are supplied declarations, not new measurements or signature verification.",
+  "type": "object",
+  "required": [
+    "perspective",
+    "shock",
+    "horizon",
+    "lef",
+    "lm",
+    "currency",
+    "curve",
+    "register",
+    "claim_scope",
+    "derived_from",
+    "rests_on_grade",
+    "response_model"
+  ],
+  "additionalProperties": false,
+  "properties": {
+    "perspective": {
+      "type": "string",
+      "minLength": 1,
+      "description": "The party whose balance sheet this scenario is on, as on its party.yaml. Every amount below is that party's money and nothing else: no sum crosses perspectives (ADR-0021, hard rule 7)."
+    },
+    "shock": {
+      "type": "string",
+      "minLength": 1,
+      "description": "What happens, in one line of plain English. The thing being priced, not its remedy."
+    },
+    "horizon": {
+      "type": "number",
+      "exclusiveMinimum": 0,
+      "description": "Years the frequency triple is expressed over. 1 unless stated otherwise; it is stated here rather than assumed by the reader (ticket 08)."
+    },
+    "lef": {
+      "type": [
+        "array",
+        "null"
+      ],
+      "minItems": 3,
+      "maxItems": 3,
+      "items": {
+        "type": "number",
+        "minimum": 0
+      },
+      "description": "Loss event frequency over `horizon` as a (min, mode, max) triple, or null. Null means the twin has no frequency and the subscribed pricing feed supplies it -- which is the normal case, because the twin prices one shock and has no clock (ADR-0021)."
+    },
+    "lm": {
+      "type": [
+        "array",
+        "object"
+      ],
+      "minItems": 3,
+      "maxItems": 3,
+      "items": {
+        "type": "number",
+        "minimum": 0
+      },
+      "required": [
+        "model",
+        "mu",
+        "sigma",
+        "u",
+        "xi",
+        "beta"
+      ],
+      "additionalProperties": false,
+      "properties": {
+        "model": {
+          "enum": [
+            "lognormal-gpd"
+          ],
+          "description": "The only severity spec fair.py dispatches to twin/severity.py for. Anything else is a new model and a new major."
+        },
+        "mu": {
+          "type": "number",
+          "description": "Lognormal body: mean of ln(loss)."
+        },
+        "sigma": {
+          "type": "number",
+          "exclusiveMinimum": 0,
+          "description": "Lognormal body: sd of ln(loss)."
+        },
+        "u": {
+          "type": "number",
+          "exclusiveMinimum": 0,
+          "description": "Threshold where the body hands over to the tail, in `currency`."
+        },
+        "xi": {
+          "type": "number",
+          "minimum": 0,
+          "description": "GPD shape, heavy or exponential tail only. Above 0 the tail is a power law and the mean is finite only for xi < 1. Bounded below at 0 because platform/fair/severity.py accepts xi >= 0: a payload this schema passes must be one the pricer can price."
+        },
+        "beta": {
+          "type": "number",
+          "exclusiveMinimum": 0,
+          "description": "GPD scale, in `currency`."
+        }
+      },
+      "description": "Loss magnitude, in `currency`, one of two shapes: a (min, mode, max) triple, which fair.py prices with its bounded beta-PERT and reports as tail `bounded-pert`; or a lognormal-GPD severity spec, which fair.py dispatches to twin/severity.py and reports under its own tail name. Expressed as one node rather than a oneOf on purpose: draft-07 applies `items` only to arrays and `required`/`properties` only to objects, so the union validates under a full validator and under the estate's stdlib subset checker alike."
+    },
+    "currency": {
+      "type": "string",
+      "pattern": "^[A-Z]{3}$",
+      "description": "ISO 4217 for scenario lm and both explicit curve amounts. The mapper requires the already annualised loss and annual costs in this currency; it supplies no FX rate."
+    },
+    "curve": {
+      "type": "array",
+      "minItems": 4,
+      "maxItems": 4,
+      "items": {
+        "type": "object",
+        "required": [
+          "account",
+          "residual_loss_per_event",
+          "annual_control_cost"
+        ],
+        "additionalProperties": false,
+        "properties": {
+          "account": {
+            "enum": [
+              "baseline",
+              "restricted",
+              "quarantine",
+              "isolated"
+            ]
+          },
+          "residual_loss_per_event": {
+            "type": "number",
+            "minimum": 0
+          },
+          "annual_control_cost": {
+            "type": "number",
+            "minimum": 0
+          }
+        }
+      },
+      "allOf": [
+        {
+          "contains": {
+            "type": "object",
+            "required": [
+              "account"
+            ],
+            "properties": {
+              "account": {
+                "const": "baseline"
+              }
+            }
+          }
+        },
+        {
+          "contains": {
+            "type": "object",
+            "required": [
+              "account"
+            ],
+            "properties": {
+              "account": {
+                "const": "restricted"
+              }
+            }
+          }
+        },
+        {
+          "contains": {
+            "type": "object",
+            "required": [
+              "account"
+            ],
+            "properties": {
+              "account": {
+                "const": "quarantine"
+              }
+            }
+          }
+        },
+        {
+          "contains": {
+            "type": "object",
+            "required": [
+              "account"
+            ],
+            "properties": {
+              "account": {
+                "const": "isolated"
+              }
+            }
+          }
+        }
+      ],
+      "description": "Exactly four named accounts. Loss is per event; control cost is per year. Runtime verifies these stated amounts against the explicit graded response model without recovering either value from a combined total."
+    },
+    "register": {
+      "type": "array",
+      "description": "C10. Entries the scenario names but does not price. Each takes the tier selected for the priced hits in the same scenario and perspective -- strictest on the ladder if nothing in the scenario priced. No new knob, and nothing runs looser than the hit it hangs off (ticket 15 answer 4). An empty register is a real answer.",
+      "items": {
+        "type": "object",
+        "required": [
+          "source",
+          "id",
+          "tier"
+        ],
+        "additionalProperties": false,
+        "properties": {
+          "source": {
+            "type": "string",
+            "minLength": 1,
+            "description": "The publisher of the id's namespace, e.g. 'nist', or the party for a bespoke control."
+          },
+          "id": {
+            "type": "string",
+            "minLength": 1,
+            "description": "The control id inside that namespace, e.g. 'sc-28'. Keyed (source, id): a bare id is not a key."
+          },
+          "tier": {
+            "enum": [
+              "baseline",
+              "restricted",
+              "quarantine",
+              "isolated",
+              "infra"
+            ],
+            "description": "The tier this unpriced entry takes, copied from the tier the scenario's priced hits selected. `infra` is only ever a platform-role party's."
+          },
+          "note": {
+            "type": "string",
+            "minLength": 1,
+            "description": "Why it is unpriced, in one line."
+          }
+        }
+      }
+    },
+    "claim_scope": {
+      "type": "object",
+      "description": "C10. What an insurance claim off this scenario would and would not cover, so the insurer prices exclusions from the same artefact the estate prices risk from (ticket 36: exclusions key on regime names and control ids). The twin writes scope; only an override prices.",
+      "required": [
+        "included",
+        "excluded"
+      ],
+      "additionalProperties": false,
+      "properties": {
+        "included": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "minLength": 1
+          },
+          "description": "Regime names ('uk-gdpr') or control keys ('nist:sc-28') this scenario's loss is claimable under."
+        },
+        "excluded": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "minLength": 1
+          },
+          "description": "The same keying, for what is carved out. An empty list is a claim of no exclusions and is read as one."
+        },
+        "note": {
+          "type": "string",
+          "minLength": 1
+        }
+      }
+    },
+    "derived_from": {
+      "type": "array",
+      "minItems": 1,
+      "description": "C10. Every pinned input this scenario was derived from, in the same shape as `inherits[]` on a party artefact, so provenance reads the same way on both sides of the seam. At least one: a scenario derived from nothing pinned is not evidence.",
+      "items": {
+        "type": "object",
+        "required": [
+          "party",
+          "kind",
+          "version"
+        ],
+        "additionalProperties": false,
+        "properties": {
+          "party": {
+            "type": "string",
+            "minLength": 1
+          },
+          "kind": {
+            "enum": [
+              "controls",
+              "implementations",
+              "feed"
+            ],
+            "description": "The closed parent kind, as on inherits[]."
+          },
+          "name": {
+            "type": "string",
+            "minLength": 1,
+            "description": "The feed's name. Required in practice when kind is feed; meaningless otherwise."
+          },
+          "version": {
+            "type": "string",
+            "minLength": 1,
+            "description": "The pinned version, no leading v."
+          },
+          "ref": {
+            "type": "string",
+            "minLength": 1,
+            "description": "The exact commit or tag read, where the version alone does not identify it (the twin's own overlay ref, say)."
+          }
+        }
+      }
+    },
+    "rests_on_grade": {
+      "type": "integer",
+      "enum": [
+        1,
+        2,
+        3
+      ]
+    },
+    "valuation": {
+      "type": "object",
+      "required": [
+        "amount",
+        "currency",
+        "native_amount",
+        "native_currency",
+        "party_fact",
+        "fx"
+      ],
+      "properties": {
+        "amount": {
+          "type": "number"
+        },
+        "currency": {
+          "type": "string"
+        },
+        "native_amount": {
+          "type": "number"
