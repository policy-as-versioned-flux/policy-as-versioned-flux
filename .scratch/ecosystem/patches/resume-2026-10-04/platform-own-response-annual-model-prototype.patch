diff --git a/compose/own_response_model.py b/compose/own_response_model.py
new file mode 100644
index 0000000..d64d1e6
--- /dev/null
+++ b/compose/own_response_model.py
@@ -0,0 +1,174 @@
+"""Strict own-response annual model: authenticated inputs, no IO or tier selection.
+
+The caller authenticates feed/source hashes and annualises gross loss once. This
+module checks the separate instruments and decomposed curve, admits mitigation
+by the signed threshold and books annual control cost once. Legacy combined net
+cost never supplies a reduction, cost period or grade.
+"""
+from __future__ import annotations
+import math
+from pathlib import PurePosixPath
+import re
+from typing import Any
+
+VERSION = '1.0.0'
+ACCOUNTS = ('baseline', 'restricted', 'quarantine', 'isolated')
+
+
+class MissingInstrument(ValueError):
+    """No complete defensible money mapping; no zero or partial total emitted."""
+
+
+def _mapping(value: Any, keys: set[str], where: str) -> dict:
+    if not isinstance(value, dict) or set(value) != keys:
+        raise MissingInstrument(f'{where}: expected exactly {sorted(keys)}')
+    return value
+
+
+def _number(value: Any, where: str) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise MissingInstrument(f'{where}: expected finite nonnegative number')
+    try:
+        number = float(value)
+    except OverflowError:
+        raise MissingInstrument(f'{where}: expected finite nonnegative number') from None
+    if not math.isfinite(number) or number < 0:
+        raise MissingInstrument(f'{where}: expected finite nonnegative number')
+    return number
+
+
+def _triple(value: Any, where: str, *, fraction: bool = False) -> list[float]:
+    if not isinstance(value, list) or len(value) != 3:
+        raise MissingInstrument(f'{where}: expected min/mode/max triple')
+    points = [_number(point, where) for point in value]
+    if points != sorted(points) or (fraction and points[-1] > 1):
+        raise MissingInstrument(f'{where}: unordered or out-of-range triple')
+    return points
+
+
+def _grade(value: Any, where: str) -> int:
+    if type(value) is not int or value not in range(1, 6):
+        raise MissingInstrument(f'{where}: explicit evidence grade1 through5 required')
+    return value
+
+
+def _basis(value: Any, where: str) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise MissingInstrument(f'{where}: explicit nonempty basis required')
+    return value
+
+
+def _accounts(rows: Any, where: str) -> dict[str, dict]:
+    if not isinstance(rows, list):
+        raise MissingInstrument(f'{where}: all named accounts required')
+    found: dict[str, dict] = {}
+    for row in rows:
+        if not isinstance(row, dict) or row.get('account') not in ACCOUNTS:
+            raise MissingInstrument(f'{where}: unknown or absent account')
+        account = row['account']
+        if account in found:
+            raise MissingInstrument(f'{where}: duplicate account {account}')
+        found[account] = row
+    if set(found) != set(ACCOUNTS):
+        raise MissingInstrument(f'{where}: missing accounts {sorted(set(ACCOUNTS) - set(found))}')
+    return found
+
+
+def annual_responses(payload: dict, annual_loss: dict, threshold: int) -> dict:
+    """Map already annualised gross loss using explicit response-model1.0.0.
+
+    Reduction/cost point estimates use declared modes; triples are never inverted
+    from a net total. Grade4/5 mitigation earns no credit and is labelled excluded.
+    Invalid, absent or nonadmitted annual cost refuses the complete mapping. The
+    caller authenticates inputs and annualises once; this module selects no tier.
+    """
+    if type(threshold) is not int or threshold not in (2, 3):
+        raise MissingInstrument('party pricing threshold must explicitly be2 or3')
+    if not isinstance(payload, dict):
+        raise MissingInstrument('payload must be a mapping')
+    model = _mapping(payload.get('response_model'),
+                     {'version', 'loss_period', 'cost_period', 'responses'}, 'response_model')
+    if model['version'] != VERSION or model['loss_period'] != 'event' or model['cost_period'] != 'year':
+        raise MissingInstrument('response_model: unsupported version or ambiguous loss/control-cost units')
+    loss = _mapping(annual_loss, {'amount', 'currency', 'period', 'perspective', 'rests_on_grade', 'frequency'},
+                    'annualised gross loss')
+    currency = payload.get('currency')
+    if not isinstance(currency, str) or not re.fullmatch('[A-Z]{3}', currency):
+        raise MissingInstrument('payload currency must be explicit ISO4217')
+    perspective = _basis(payload.get('perspective'), 'payload perspective')
+    if loss['currency'] != currency or loss['perspective'] != perspective or loss['period'] != 'year':
+        raise MissingInstrument('annual gross loss must share perspective/currency and explicit year units')
+    amount = _number(loss['amount'], 'annualised gross loss amount')
+    money_grade = _grade(loss['rests_on_grade'], 'annualised gross loss grade')
+    payload_grade = _grade(payload.get('rests_on_grade'), 'payload weakest grade')
+    if money_grade < payload_grade or max(money_grade, payload_grade) > threshold:
+        raise MissingInstrument('gross loss/payload is not admitted at declared pricing threshold')
+    frequency = _mapping(loss['frequency'], {'triple', 'horizon_years'}, 'annualisation frequency')
+    lef = _triple(frequency['triple'], 'annualisation frequency')
+    horizon = _number(frequency['horizon_years'], 'annualisation horizon_years')
+    if horizon <= 0 or horizon != _number(payload.get('horizon'), 'payload horizon'):
+        raise MissingInstrument('annualisation horizon_years must be positive and match payload horizon')
+    annual_frequency = _triple([point / horizon for point in lef], 'derived annual frequency')
+    magnitude = _triple(payload.get('lm'), 'per-event loss magnitude')[1]
+    responses = _accounts(model['responses'], 'response_model')
+    curve = _accounts(payload.get('curve'), 'published decomposed curve')
+    residuals: dict[str, float] = {}
+    costs: dict[str, float] = {}
+    totals: dict[str, float] = {}
+    excluded: list[dict] = []
+    sources: dict[str, dict] = {}
+    grades = [money_grade, payload_grade]
+    for account in ACCOUNTS:
+        row = _mapping(responses[account], {'account', 'mitigation', 'control_cost', 'source'}, account)
+        source = _mapping(row['source'], {'path', 'sha256'}, f'{account} source')
+        path, digest = source['path'], source['sha256']
+        if (not isinstance(path, str) or '\\' in path or PurePosixPath(path).is_absolute()
+                or '..' in PurePosixPath(path).parts or not path or path == '.'):
+            raise MissingInstrument(f'{account}: source must be a relative declared POSIX path')
+        if not isinstance(digest, str) or not re.fullmatch('[a-f0-9]{64}', digest):
+            raise MissingInstrument(f'{account}: source must name exact SHA256')
+        sources[account] = dict(source)
+        reduction = 0.0  # no claim/no admitted credit; never a default zero money price
+        if row['mitigation'] is not None:
+            mitigation = _mapping(row['mitigation'], {'triple', 'evidence_grade', 'basis'}, f'{account} mitigation')
+            points = _triple(mitigation['triple'], f'{account} reduction', fraction=True)
+            grade = _grade(mitigation['evidence_grade'], f'{account} mitigation grade')
+            _basis(mitigation['basis'], f'{account} mitigation basis')
+            if grade <= threshold:
+                reduction = points[1]
+                grades.append(grade)
+            else:
+                excluded.append({'account': account, 'evidence_grade': grade,
+                                 'reason': f'not admitted at pricing threshold {threshold}; no mitigation credit'})
+        cost = _mapping(row['control_cost'], {'triple', 'currency', 'period', 'evidence_grade', 'nature', 'basis'},
+                        f'{account} annual control cost')
+        points = _triple(cost['triple'], f'{account} annual control cost')
+        grade = _grade(cost['evidence_grade'], f'{account} annual control cost grade')
+        if grade > threshold:
+            raise MissingInstrument(f'{account}: cost grade{grade} not admitted; no monetary total')
+        if cost['currency'] != currency or cost['period'] != 'year':
+            raise MissingInstrument(f'{account}: control cost needs matching currency and explicit year period')
+        if (cost['nature'] not in ('measurement', 'published-estimate')
+                or (cost['nature'] == 'measurement' and grade > 2)
+                or (cost['nature'] == 'published-estimate' and grade != 3)):
+            raise MissingInstrument(f'{account}: cost nature/grade identifies no admitted monetary instrument')
+        _basis(cost['basis'], f'{account} annual cost basis')
+        grades.append(grade)
+        point = _mapping(curve[account], {'account', 'residual_loss_per_event', 'annual_control_cost'},
+                         f'{account} decomposed curve')
+        if (not math.isclose(_number(point['residual_loss_per_event'], account), magnitude * (1 - reduction),
+                             rel_tol=1e-12, abs_tol=1e-6)
+                or not math.isclose(_number(point['annual_control_cost'], account), points[1],
+                                    rel_tol=1e-12, abs_tol=1e-6)):
+            raise MissingInstrument(f'{account}: decomposed curve differs from admitted response instruments')
+        residuals[account] = _number(amount * (1 - reduction), f'{account} derived annual residual')
+        costs[account] = points[1]
+        totals[account] = _number(residuals[account] + costs[account], f'{account} derived annual total')
+    return {'residuals': residuals, 'annual_control_costs': costs, 'annual_total_costs': totals,
+            'rests_on_grade': max(grades), 'excluded_mitigations': excluded,
+            'provenance': {'model_version': VERSION, 'point_estimate': 'declared-mode',
+                           'loss_period': 'year', 'control_cost_period': 'year',
+                           'perspective': perspective, 'currency': currency,
+                           'frequency_per_year': annual_frequency,
+                           'annualisation': 'already upstream; no frequency multiplication here',
+                           'source': sources, 'authentication': 'caller verifies signed feed and input hashes'}}
