diff --git a/gitops/apps/api.yaml b/gitops/apps/api.yaml
new file mode 100644
index 0000000..47f6eaa
--- /dev/null
+++ b/gitops/apps/api.yaml
@@ -0,0 +1,23 @@
+# Ticket 154: API lifted from its transferred app repo. The adopter's served policy array
+# declares 5.0.0; its governed Namespace owns the rung. A Pod reaches the pod-only cage.
+# The image digest was read anonymously from the existing v1.0.1 GHCR manifest on 2026-10-03.
+apiVersion: v1
+kind: Pod
+metadata:
+  name: api
+  namespace: driftwood
+  labels:
+    app: api
+    app.kubernetes.io/part-of: driftwood
+    policy-as-versioned.dev/policy-version: "5.0.0"
+spec:
+  securityContext:
+    runAsNonRoot: true
+    runAsUser: 1000
+  containers:
+    - name: api
+      image: ghcr.io/policy-as-versioned-driftwood/api:v1.0.1@sha256:90ccb85d903b8137863695681c2cf6b8cb85ba59835be5e24857e72895b977a3
+      ports:
+        - containerPort: 8080
+      securityContext:
+        readOnlyRootFilesystem: true
