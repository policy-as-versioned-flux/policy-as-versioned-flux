ls above"}}, "kind": "flux.five-facts/v1", "party": "ludlow", "pin": {"commit": "45b3fbd21d2838f8882dfa6265b3a6e8fa61b3a9", "consumer": "resourceset", "pin_from": "gitops/composed/composed-set.yaml", "tag": "v3.0.0", "url": "https://github.com/policy-as-versioned-ludlow/ludlow"}, "reachable": true, "reason": "", "revision": "sha1:7bd9973be43de0b5d1d13b7eb46a1a60b01516ec", "run": "37029256742", "schema_version": 2, "source": "ludlow-composed", "ts": "2026-10-02T15:47:14Z", "verdict": "COULD-NOT-LOOK"}
