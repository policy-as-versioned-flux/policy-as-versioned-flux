{
 "apiVersion": "v1",
 "kind": "Pod",
 "metadata": {
  "name": "cage-probe",
  "namespace": "cage-probe-control",
  "labels": {}
 },
 "spec": {
  "securityContext": {
   "runAsNonRoot": true,
   "runAsUser": 65532
  },
  "containers": [
   {
    "name": "app",
    "image": "ghcr.io/acme/coraza-waf:cage",
    "imagePullPolicy": "IfNotPresent",
    "securityContext": {
     "readOnlyRootFilesystem": true
    }
   }
  ]
 }
}