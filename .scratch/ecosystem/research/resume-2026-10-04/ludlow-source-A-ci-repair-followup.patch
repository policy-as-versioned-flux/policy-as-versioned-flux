+class WorkflowHistory(unittest.TestCase):
+    def test_history_reading_jobs_fetch_the_immutable_apps_tags_and_keep_history(self):
+        import yaml
+        workflow = yaml.safe_load((ROOT / '.github/workflows/shift-left.yml').read_text())
+        for name in ('shift-left', 'compose-check'):
+            with self.subTest(job=name):
+                steps = workflow['jobs'][name]['steps']
+                own = next(step for step in steps if step.get('uses', '').startswith('actions/checkout@')
+                           and step.get('with', {}).get('path') == 'ludlow'
+                           and 'repository' not in step.get('with', {}))
+                self.assertEqual(own['with'].get('fetch-depth', 1), 0,
+                                 'inventory and since pricing require genuine adopter tags/history')
+                for step in steps:
+                    for line in step.get('run', '').splitlines():
+                        if 'git -C ludlow fetch' in line:
+                            self.assertNotIn('--depth', line, 'a later fetch must not truncate signed history')
+
