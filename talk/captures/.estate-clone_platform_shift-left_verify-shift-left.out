policy cage-tier-2-0-0 applied to default/Pod/checkout-svc:
apiVersion: v1
kind: Pod
metadata:
    labels:
        policy-as-versioned.dev/policy-version: 2.0.0
        posture.acme.io/caged: "true"
        posture.acme.io/version: 2.0.0
    name: checkout-svc
    namespace: default
spec:
    containers:
        - image: nginx
          name: c
          resources:
            limits:
                cpu: 500m
                memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: false
            runAsNonRoot: false
    priorityClassName: cage-baseline-2-0-0
    securityContext:
        runAsNonRoot: true

---


