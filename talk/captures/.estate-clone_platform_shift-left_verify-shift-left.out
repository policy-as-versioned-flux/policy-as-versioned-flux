policy cage-netpol-2-0-0 applied to default/Pod/checkout-svc:
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
    labels:
        app.kubernetes.io/managed-by: kyverno
        posture.acme.io/cage: egress-lockdown
    name: cage-egress-lockdown
    namespace: default
spec:
    egress:
        - ports:
            - port: 53
              protocol: UDP
          to:
            - namespaceSelector:
                matchLabels:
                    kubernetes.io/metadata.name: kube-system
    podSelector:
        matchLabels:
            posture.acme.io/caged: "true"
    policyTypes:
        - Egress

---


