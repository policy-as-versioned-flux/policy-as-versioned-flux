apiVersion: v1
kind: Pod
metadata:
  labels:
    policy-as-versioned.dev/policy-version: 4.0.0
    posture.acme.io/caged: "true"
    posture.acme.io/tier: baseline
    posture.acme.io/version: 4.0.0
  name: checkout-svc
  namespace: default
spec:
  containers:
  - image: nginx
