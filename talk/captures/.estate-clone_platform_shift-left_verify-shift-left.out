      privileged: false
      readOnlyRootFilesystem: true
      runAsNonRoot: false
  hostIPC: false
  hostNetwork: false
  hostPID: false
  preemptionPolicy: Never
  priority: -10
  priorityClassName: cage-baseline-4-0-0
  securityContext:
    runAsNonRoot: true

